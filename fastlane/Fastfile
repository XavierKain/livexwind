# fastlane — build signé + upload TestFlight, 100 % depuis GitHub Actions.
#
# Secrets GitHub requis (Settings > Secrets and variables > Actions) :
#   APPLE_TEAM_ID       — Team ID Apple Developer
#   ASC_KEY_ID          — ID de la clé API App Store Connect
#   ASC_ISSUER_ID       — Issuer ID (App Store Connect > Users > Integrations)
#   ASC_KEY_P8_BASE64   — contenu du .p8 encodé en base64
#   MATCH_PASSWORD      — passphrase qui chiffre les certificats (branche match-certs)

default_platform(:ios)

APP_ID = "com.xavierkain.livexwind"
WIDGET_ID = "com.xavierkain.livexwind.widget"
APP_NAME = "LiveXWind"

def connect_token
  require "spaceship"
  key_path = File.expand_path("asc_key.p8")
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )
end

# Crée les bundle IDs manquants via l'API officielle App Store Connect.
def ensure_bundle_ids
  connect_token
  existing = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
  { APP_ID => APP_NAME, WIDGET_ID => "#{APP_NAME} Widget" }.each do |identifier, name|
    next if existing.include?(identifier)
    UI.message("Création du bundle ID #{identifier}…")
    Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
  end

  # L'app pousse l'activité en direct et les alertes par APNs : il lui faut la capability Push.
  main = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
  if main
    has_push = begin
      main.get_capabilities.any? { |c| c.capability_type == "PUSH_NOTIFICATIONS" }
    rescue StandardError
      false
    end
    unless has_push
      UI.message("Activation de Push Notifications sur #{APP_ID}…")
      main.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS)
    end
  end
rescue StandardError => e
  UI.important("ensure_bundle_ids a échoué (#{e.message}).")
  UI.important("Fallback manuel : crée #{APP_ID} et #{WIDGET_ID} sur developer.apple.com > Identifiers.")
end

def ensure_app_record_exists
  return if Spaceship::ConnectAPI::App.find(APP_ID)

  # L'API App Store Connect n'expose pas POST /v1/apps (vérifié : "The path provided
  # does not match a defined resource type") — la fiche se crée à la main, une fois.
  UI.user_error!(<<~MSG)
    L'app n'existe pas encore dans App Store Connect (l'API Apple ne permet pas de la créer).
    À faire une seule fois :
      1. https://appstoreconnect.apple.com > Apps > + > Nouvelle app
      2. Plateforme iOS, nom "#{APP_NAME}", bundle ID #{APP_ID}, SKU "livexwind"
    Puis relance ce workflow.
  MSG
end

platform :ios do
  desc "État du build et des groupes TestFlight"
  lane :status do
    connect_token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App introuvable") unless app
    UI.important("App : #{app.name} (#{app.bundle_id})")

    app.get_builds(includes: "preReleaseVersion,buildBetaDetail").first(3).each do |b|
      detail = b.build_beta_detail rescue nil
      UI.message("Build #{b.version} — processing #{b.processing_state} — " \
                 "interne #{detail&.internal_build_state} — expiré #{b.expired}")
    end

    # Un groupe interne avec has_access_to_all_builds reçoit chaque build sans
    # rattachement explicite — c'est pour ça que la lane beta n'en fait pas.
    app.get_beta_groups.each do |g|
      UI.message("Groupe « #{g.name} » — interne #{g.is_internal_group} — " \
                 "reçoit tous les builds #{g.has_access_to_all_builds}")
    end
  end

  desc "Build signé + upload TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    ensure_bundle_ids
    ensure_app_record_exists

    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER", "1"),
      xcodeproj: "#{APP_NAME}.xcodeproj"
    )

    match(
      type: "appstore",
      app_identifier: [APP_ID, WIDGET_ID],
      api_key: api_key,
      readonly: false,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "match-certs",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}")
    )

    build_app(
      project: "#{APP_NAME}.xcodeproj",
      scheme: APP_NAME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_ID => "match AppStore #{APP_ID}",
          WIDGET_ID => "match AppStore #{WIDGET_ID}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("✅ Build envoyé sur TestFlight — dispo d'ici ~10-30 min.")
  end
end
