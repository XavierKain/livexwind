# fastlane — build signé + upload TestFlight, 100 % depuis GitHub Actions.
#
# Secrets GitHub requis (Settings > Secrets and variables > Actions) :
#   APPLE_TEAM_ID       — Team ID Apple Developer
#   ASC_KEY_ID          — ID de la clé API App Store Connect
#   ASC_ISSUER_ID       — Issuer ID (App Store Connect > Users > Integrations)
#   ASC_KEY_P8_BASE64   — contenu du .p8 encodé en base64
#   MATCH_PASSWORD      — passphrase qui chiffre les certificats (branche match-certs)

default_platform(:ios)

APP_ID = "com.xavierkain.livexwind"
WIDGET_ID = "com.xavierkain.livexwind.widget"
WATCH_ID = "com.xavierkain.livexwind.watchkitapp"
WATCH_WIDGET_ID = "com.xavierkain.livexwind.watchkitapp.widget"
ALL_IDS = [APP_ID, WIDGET_ID, WATCH_ID, WATCH_WIDGET_ID].freeze
APP_NAME = "LiveXWind"

def connect_token
  require "spaceship"
  key_path = File.expand_path("asc_key.p8")
  File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: key_path
  )
end

# Crée les bundle IDs manquants via l'API officielle App Store Connect.
def ensure_bundle_ids
  connect_token
  existing = Spaceship::ConnectAPI::BundleId.all.map(&:identifier)
  {
    APP_ID => APP_NAME,
    WIDGET_ID => "#{APP_NAME} Widget",
    WATCH_ID => "#{APP_NAME} Watch",
    WATCH_WIDGET_ID => "#{APP_NAME} Watch Complication",
  }.each do |identifier, name|
    next if existing.include?(identifier)
    UI.message("Création du bundle ID #{identifier}…")
    Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "IOS")
  end

  # L'app pousse l'activité en direct et les alertes par APNs : il lui faut la capability Push.
  main = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
  if main
    has_push = begin
      main.get_capabilities.any? { |c| c.capability_type == "PUSH_NOTIFICATIONS" }
    rescue StandardError
      false
    end
    unless has_push
      UI.message("Activation de Push Notifications sur #{APP_ID}…")
      main.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS)
    end
  end
rescue StandardError => e
  UI.important("ensure_bundle_ids a échoué (#{e.message}).")
  UI.important("Fallback manuel : crée #{APP_ID} et #{WIDGET_ID} sur developer.apple.com > Identifiers.")
end

def ensure_app_record_exists
  return if Spaceship::ConnectAPI::App.find(APP_ID)

  # L'API App Store Connect n'expose pas POST /v1/apps (vérifié : "The path provided
  # does not match a defined resource type") — la fiche se crée à la main, une fois.
  UI.user_error!(<<~MSG)
    L'app n'existe pas encore dans App Store Connect (l'API Apple ne permet pas de la créer).
    À faire une seule fois :
      1. https://appstoreconnect.apple.com > Apps > + > Nouvelle app
      2. Plateforme iOS, nom "#{APP_NAME}", bundle ID #{APP_ID}, SKU "livexwind"
    Puis relance ce workflow.
  MSG
end

platform :ios do
  desc "État du build et des groupes TestFlight"
  lane :status do
    connect_token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("App introuvable") unless app
    UI.important("App : #{app.name} (#{app.bundle_id})")

    app.get_builds(includes: "preReleaseVersion,buildBetaDetail").first(3).each do |b|
      detail = b.build_beta_detail rescue nil
      UI.message("Build #{b.version} — processing #{b.processing_state} — " \
                 "interne #{detail&.internal_build_state} — expiré #{b.expired}")
    end

    # Un groupe interne avec has_access_to_all_builds reçoit chaque build sans
    # rattachement explicite — c'est pour ça que la lane beta n'en fait pas.
    app.get_beta_groups.each do |g|
      UI.message("Groupe « #{g.name} » — interne #{g.is_internal_group} — " \
                 "reçoit tous les builds #{g.has_access_to_all_builds}")
    end
  end

  desc "Diagnostic testeurs internes (emails masqués : logs Actions publics)"
  lane :diag do
    connect_token
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    mask = lambda do |email|
      return "?" if email.nil? || email.empty?
      local, _, domain = email.partition("@")
      "#{local[0, 3]}***@#{domain}"
    end

    UI.important("— API disponible —")
    UI.message("client: #{Spaceship::ConnectAPI.client.methods.grep(/beta_tester|user/).sort.join(', ')}")

    groups = app.get_beta_groups
    groups.each do |g|
      UI.important("Groupe « #{g.name} » — interne #{g.is_internal_group} — tous builds #{g.has_access_to_all_builds}")
      UI.message("  méthodes: #{(g.methods - Object.instance_methods).grep(/tester|build/).sort.join(', ')}")

      testers = nil
      [
        -> { g.get_beta_testers },
        -> { Spaceship::ConnectAPI.client.get_beta_testers(filter: { betaGroups: g.id }).to_models },
        -> { Spaceship::ConnectAPI.client.get_beta_testers(filter: { apps: app.id }).to_models }
      ].each do |attempt|
        begin
          testers = attempt.call
          break if testers
        rescue StandardError => e
          UI.message("  (essai: #{e.class})")
        end
      end

      if testers.nil?
        UI.message("  testeurs : illisibles")
      elsif testers.empty?
        UI.message("  testeurs : AUCUN rattaché à ce groupe")
      else
        testers.each do |t|
          UI.message("  testeur #{mask.call(t.email)} — état #{t.state rescue '?'} — invite #{t.invite_type rescue '?'}")
        end
      end
    end

    UI.important("— Utilisateurs de l'équipe —")
    begin
      Spaceship::ConnectAPI::User.all.each do |u|
        UI.message("#{mask.call(u.username)} — rôles #{Array(u.roles).join('/')} — toutes apps #{u.all_apps_visible}")
      end
    rescue StandardError => e
      UI.message("utilisateurs illisibles (#{e.class}: #{e.message})")
    end

    UI.important("— Invitations en attente —")
    begin
      invites = Spaceship::ConnectAPI::UserInvitation.all
      if invites.empty?
        UI.message("aucune")
      else
        invites.each { |i| UI.message("#{mask.call(i.email)} — rôles #{Array(i.roles).join('/')}") }
      end
    rescue StandardError => e
      UI.message("invitations illisibles (#{e.class}: #{e.message})")
    end
  end

  desc "Retire puis remet le testeur interne dans le groupe : force un nouvel email d'invitation"
  lane :reinvite do
    connect_token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    group = app.get_beta_groups.find(&:is_internal_group)
    UI.user_error!("Aucun groupe interne") unless group

    testers = Spaceship::ConnectAPI.client.get_beta_testers(filter: { apps: app.id }).to_models
    UI.user_error!("Aucun testeur sur l'app") if testers.empty?

    testers.each do |t|
      masked = "#{t.email.to_s.partition('@').first[0, 3]}***@#{t.email.to_s.partition('@').last}"

      # Le retrait est ignoré si le testeur n'est déjà plus dans le groupe.
      begin
        Spaceship::ConnectAPI.client.delete_beta_tester_from_beta_groups(
          beta_tester_id: t.id, beta_group_ids: [group.id]
        )
        UI.message("#{masked} retiré du groupe")
      rescue StandardError => e
        UI.important("retrait ignoré (#{e.class}: #{e.message})")
      end

      sleep(3)

      added = false
      [
        -> { group.add_beta_testers(beta_tester_ids: [t.id]) },
        -> { Spaceship::ConnectAPI.client.add_beta_tester_to_group(beta_group_id: group.id, beta_tester_ids: [t.id]) }
      ].each do |attempt|
        begin
          attempt.call
          added = true
          break
        rescue StandardError => e
          UI.message("(essai d'ajout : #{e.class}: #{e.message})")
        end
      end

      UI.success("#{masked} remis dans « #{group.name} » — un nouvel email part maintenant") if added
      UI.error("#{masked} n'a pas pu être remis dans le groupe") unless added
    end
  end

  desc "Build signé + upload TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )

    ensure_bundle_ids
    ensure_app_record_exists

    increment_build_number(
      build_number: ENV.fetch("BUILD_NUMBER", "1"),
      xcodeproj: "#{APP_NAME}.xcodeproj"
    )

    match(
      type: "appstore",
      app_identifier: ALL_IDS,
      api_key: api_key,
      readonly: false,
      storage_mode: "git",
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "match-certs",
      git_basic_authorization: Base64.strict_encode64("x-access-token:#{ENV.fetch('GITHUB_TOKEN')}")
    )

    build_app(
      project: "#{APP_NAME}.xcodeproj",
      scheme: APP_NAME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: ALL_IDS.to_h { |id| [id, "match AppStore #{id}"] }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )

    UI.success("✅ Build envoyé sur TestFlight — dispo d'ici ~10-30 min.")
  end
end
